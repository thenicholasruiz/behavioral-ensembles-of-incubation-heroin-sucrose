#Class 13 Script
library(haven)
library(lavaan)
library(semPlot)

cl13_df1 <- read.csv('D:/Google Drive/fall 2021/multivariate/week 13/cl13df.csv')
names(cl13_df1)

cl13_m1 <- 'Stats =~ st1 + st2 + st3
            SciProd =~ sp1 + sp2 + sp3
            JobPerf =~ jp1 + jp2 + jp3
            
            JobPerf ~ c*Stats + b*SciProd
            SciProd ~ a*Stats
            
            #Indirect effect
            ab := a*b
            #Total effect
            tot_eff := c + (a*b)'

cl13_m1_fit <- sem(cl13_m1, cl13_df1, se = "bootstrap", bootstrap = 500)

fitMeasures(cl13_m1_fit, c("npar", "chisq", "df", "pvalue", "cfi", "rmsea", "rmsea.ci.lower", "rmsea.ci.upper", "rmsea.pvalue", "BIC", "AIC"))

summary(cl13_m1_fit)

parameterestimates(cl13_m1_fit, boot.ci.type = "bca.simple")

semPaths(cl13_m1_fit, whatLabels = "std", nCharNodes = 0, rotation = 2, edge.label.cex=1.25,edge.color="black",
         sizeMan=10,sizeLat=10,fade=FALSE,esize=2,asize=2)

