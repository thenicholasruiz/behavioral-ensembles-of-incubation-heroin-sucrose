```{r}
# what about session 1 predicts session 2
inc_dbl_scr %>%
  mutate(drug_inc = case_when(drug == 2 & session == 2 ~ 2,
                              drug == 2 & session == 1 ~ 1,
                              drug == 1 & session == 1 ~ 1,
                              drug == 1 & session == 2 ~ 1,)) ->inc_dbl_scr

# rats with both sessions
# predictors at day 1 of day 2 behavior
inc_dbl_scr %>%
  group_by(subject) %>%
  filter(all(c(1, 2) %in% session)) -> two_sesh
```

```{r}
m1 <- lmer(lever ~ shake:drug_inc + beam:drug_inc + sniff:drug_inc + groom:drug_inc  + (1|subject),data=inc_dbl_scr)
summary(m1)
```




