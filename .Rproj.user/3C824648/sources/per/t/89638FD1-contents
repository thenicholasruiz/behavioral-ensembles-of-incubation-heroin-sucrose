```{r setup, include=FALSE}
knitr::opts_chunk$set(echo = TRUE)

library(tidyverse)
library(readxl)
```



```{r import data}
inc_raw_data = read_excel("inc_all_data_final.xlsx",sheet = "raw_data")
inc_dbl_scr_hand = read_excel("inc_all_data_final.xlsx",sheet = "double_scored")
```



```{r double score data}
# double score the data by averaging across the coders for each rat, session, drug, sex, and timepoint

inc_raw_data %>%
  group_by(subject,drug,sex,session,time) %>%
  summarise(beam = mean(beam_breaks,na.rm = TRUE),
            sniff_cnt = mean(sniff_cnt,na.rm = TRUE),
            sniff = mean(sniffing,na.rm = TRUE),
            groom_cnt = mean(groom_cnt,na.rm = TRUE),
            groom = mean(grooming,na.rm = TRUE),
            shake = mean(shakes,na.rm = TRUE),
            seek_cnt = mean(seeking_cnt,na.rm = TRUE),
            seek = mean(seeking,na.rm = TRUE),
            lever = mean(lever,na.rm = TRUE)) -> inc_dbl_scr

inc_dbl_scr$time = as.factor(inc_dbl_scr$time)
inc_dbl_scr$session = as.factor(inc_dbl_scr$session)

inc_dbl_scr$sex = as.factor(inc_dbl_scr$sex)
inc_dbl_scr$drug = as.factor(inc_dbl_scr$drug)
```



```{r data organzation}
# calculate within session means and sems for plotting

inc_dbl_scr %>%
  group_by(sex,drug,session,time) %>%
  summarise(mean_lever = mean(lever,na.rm = TRUE),
            sem_lever = sd(lever,na.rm = TRUE)/sqrt(length(lever)),
            mean_beam = mean(beam,na.rm = TRUE),
            sem_beam = sd(beam,na.rm = TRUE)/sqrt(length(beam)),
            mean_sniff = mean(sniff,na.rm = TRUE),
            sem_sniff = sd(sniff,na.rm = TRUE)/sqrt(length(sniff)),
            mean_groom = mean(groom,na.rm = TRUE),
            sem_groom = sd(groom,na.rm = TRUE)/sqrt(length(groom)),
            mean_seek = mean(seek,na.rm = TRUE),
            sem_seek = sd(seek,na.rm = TRUE)/sqrt(length(seek)),
            mean_shake = mean(shake,na.rm = TRUE),
            sem_shake = sd(shake,na.rm = TRUE)/sqrt(length(shake)),
            mean_sniff_cnt = mean(sniff_cnt,na.rm = TRUE),
            sem_sniff_cnt = sd(sniff_cnt,na.rm = TRUE)/sqrt(length(sniff_cnt)),
            mean_groom_cnt = mean(groom_cnt,na.rm = TRUE),
            sem_groom_cnt = sd(groom_cnt,na.rm = TRUE)/sqrt(length(groom_cnt)),
            mean_seek_cnt = mean(seek_cnt,na.rm = TRUE),
            sem_seek_cnt = sd(seek_cnt,na.rm = TRUE)/sqrt(length(seek_cnt))) -> means_sems_all

means_sems_all$session = as.factor(means_sems_all$session)
```



```{r labels}
sex_labels = c("Male","Female")
names(sex_labels) = c("1","2")

drug_labels = c("Heroin","Sucrose")
names(drug_labels) = c("1","2")
```

# plots!

```{r lever plotting}
means_sems_all %>%
  filter(sex == 1 | sex == 2) %>%
  ggplot(mapping = aes(x = time, y = mean_lever, fill = session)) + 
  geom_col(position = "dodge") + 
  geom_errorbar(aes(ymin=mean_lever-sem_lever,ymax=mean_lever+sem_lever),width=0.2,
                position=position_dodge(1)) +
  facet_wrap(drug~sex,
             labeller = labeller(drug=drug_labels,sex=sex_labels)) +  
  scale_x_discrete(name ="Time", 
                    limits=c("1","2","3","4","5","6")) + 
  scale_fill_discrete(labels=c("Day 1", "Day 30")) +
  labs(title="Lever Presses by Drug, Sex, and Session",
        x ="Time", y = "Lever Presses")
```

