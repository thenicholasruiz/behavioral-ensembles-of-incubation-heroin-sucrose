### re-doing figure 2 as a correlation map


```{r}
library(dplyr)
library(corrplot)

# Step 1: Subject-level means
subject_means <- inc_sneek %>%
  group_by(subject) %>%
  summarise(across(c(lever, beam, sneek, groom, shake), mean, na.rm = TRUE))

# Step 2: Compute correlation matrix
cor_matrix <- cor(subject_means[, -1], use = "pairwise.complete.obs")

# Step 3: Rename the row and column names
colnames(cor_matrix) <- c("Lever Presses", "Locomotion", "Sniffing", "Grooming", "Shakes")
rownames(cor_matrix) <- c("Lever Presses", "Locomotion", "Sniffing", "Grooming", "Shakes")

# Step 4: Plot only the bottom half

corrplot(
  cor_matrix,
  method = "color",          # color-filled tiles
  type = "lower",            # only show lower triangle
  addCoef.col = "black",     # show correlation values
  tl.col = "black",          # axis label color
  tl.cex = 1.2,              # axis label size
  number.cex = 1.1,          # text size for coefficients
  diag = TRUE               # remove diagonal
)

```

# correlational heat map across four conditions

```{r}
library(tidyverse)
library(corrplot)

# Define custom labels
var_labels <- c("Lever Presses", "Locomotion", "Sniffing", "Grooming", "Shakes")

# Step 1: Get all combinations of drug and session
combinations <- expand.grid(
  drug = c("Heroin", "Sucrose"),
  session = c("Day 1", "Day 30"),
  stringsAsFactors = FALSE
)

# Step 2: Set up plotting area
png("correlation_maps_by_drug_session.png", width = 1200, height = 1200, res = 200)
par(mfrow = c(2, 2), mar = c(2, 2, 4, 2))  # 2x2 layout with space for titles

# Step 3: Loop through each combination
for (i in 1:nrow(combinations)) {
  d <- combinations$drug[i]
  s <- combinations$session[i]
  
  # Filter and compute subject-level means
  df_sub <- inc_sneek %>%
    filter(drug == d, session == s) %>%
    group_by(subject) %>%
    summarise(across(c(lever, beam, sneek, groom, shake), mean, na.rm = TRUE), .groups = "drop")
  
  # Compute correlation matrix
  cor_matrix <- cor(df_sub[, -1], use = "pairwise.complete.obs")
  
  # Set axis labels
  colnames(cor_matrix) <- var_labels
  rownames(cor_matrix) <- var_labels
  
  # Plot
  corrplot(
    cor_matrix,
    method = "color",
    type = "lower",
    addCoef.col = "black",
    tl.col = "black",
    tl.cex = 0.7,
    t.srt = 45,
    number.cex = 0.9,
    diag = FALSE,
    title = paste0(d, " - ", s),
    mar = c(0, 0, 2, 0)  # margin for title
  )
}

# Step 4: Close PNG device
