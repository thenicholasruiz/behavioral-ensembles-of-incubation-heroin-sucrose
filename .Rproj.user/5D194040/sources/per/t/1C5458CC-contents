```{r}
# fig2_colors should be a named vector whose names match the strings
# you pass in for x_var, e.g.:
fig2_colors <- c(beam = "#F8766D", sneek = "#00BFC4",
                 groom = "#7CAE00", shake = "#C77CFF")

create_fig2 <- function(data, x_var,
                        x_label, y_label,
                        x_limits, y_limits,
                        effects_mat,
                        fig2_colors,
                        point_col = "grey50") {

  # Pick the colour that corresponds to the x-variable
  this_col <- fig2_colors[[x_var]]

  ggplot() +
    ## points (NOT coloured by session or x_var)
    geom_point(
      data = data,
      aes(x = .data[[x_var]], y = lever),
      alpha = 0.2,
      colour = point_col
    ) +

    ## ribbon (keeps y = fit as you requested)
    geom_ribbon(
      data = effects_mat,
      aes(x = .data[[x_var]], y = fit,
          ymin = lower, ymax = upper),
      fill   = this_col,   # constant fill chosen above
      colour = NA,         # no border
      alpha  = 0.2
    ) +

    ## line (same constant colour)
    geom_line(
      data = effects_mat,
      aes(x = .data[[x_var]], y = fit),
      colour   = this_col,
      linewidth = 2
    ) +

    labs(x = x_label, y = y_label) +

    # keep axes and theme
    theme(
      axis.title = element_text(size = 30),
      axis.text  = element_text(size = 25)
    ) +

    coord_cartesian(xlim = x_limits, ylim = y_limits)
  
}
```


