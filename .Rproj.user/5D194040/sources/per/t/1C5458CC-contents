# get full stats of correlations

```{r}
library(tidyverse)
library(corrplot)

# Labels
var_labels <- c("Lever Presses", "Locomotion", "Sniffing", "Grooming", "Shakes")

# All condition combinations
combinations <- expand.grid(
  drug = c("Heroin", "Sucrose"),
  session = c("Day 1", "Day 30"),
  stringsAsFactors = FALSE
)

# Initialize list to store correlation matrices
cor_matrices <- list()

# Loop through combinations and store correlations
for (i in 1:nrow(combinations)) {
  d <- combinations$drug[i]
  s <- combinations$session[i]
  label <- paste(d, s, sep = "_")
  
  df_sub <- inc_sneek %>%
    filter(drug == d, session == s) %>%
    group_by(subject) %>%
    summarise(across(c(lever, beam, sneek, groom, shake), mean, na.rm = TRUE), .groups = "drop")
  
  cor_matrix <- cor(df_sub[, -1], use = "pairwise.complete.obs")
  
  colnames(cor_matrix) <- var_labels
  rownames(cor_matrix) <- var_labels
  
  # Store matrix
  cor_matrices[[label]] <- cor_matrix
}
```

# export to .csv

```{r}
# Function to flatten lower triangle of a correlation matrix
flatten_corr <- function(mat, condition_label) {
  combs <- combn(rownames(mat), 2)
  data.frame(
    Condition = condition_label,
    Var1 = combs[1, ],
    Var2 = combs[2, ],
    r = mapply(function(x, y) mat[x, y], combs[1, ], combs[2, ])
  )
}

# Apply to all matrices and bind into one data frame
cor_flat_df <- purrr::imap_dfr(cor_matrices, flatten_corr)

# View or save
print(cor_flat_df)
write.csv(cor_flat_df, "correlations_by_condition.csv", row.names = FALSE)
```





