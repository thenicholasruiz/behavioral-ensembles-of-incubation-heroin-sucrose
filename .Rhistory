p <- ggplot() +
# Raw data
geom_point(
data = raw_long,
aes(x = value, y = lever, color = session),
alpha = 0.35, size = 1
) +
# Marginal-means lines
geom_line(
data = pred_all,
aes(x = value, y = fit, color = session, group = session),
linewidth = 1.1
) +
geom_ribbon(
data = pred_all,
aes(x = value, ymin = lower, ymax = upper, fill = session),
alpha = 0.12, color = NA, inherit.aes = FALSE
) +
scale_fill_manual(values = session_colors, guide = "none") +
facet_grid(rows = vars(drug), cols = vars(behavior), scales = "free_x") +
scale_color_manual(values = session_colors, name = "Session") +
labs(
x = NULL,
y = "Lever presses",
title = "Lever pressing vs. behavioral features by Drug and Session",
subtitle = "Lines = marginal means from LME models; Points = raw observations"
) +
theme_minimal(base_size = 12) +
theme(
panel.grid.minor = element_blank(),
strip.text = element_text(face = "bold"),
plot.title = element_text(face = "bold")
)
p
