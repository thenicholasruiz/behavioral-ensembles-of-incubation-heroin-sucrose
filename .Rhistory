formula(lev_m7)
inc_sneek <- inc_sneek %>%
mutate(
session_f = factor(
session,
levels = c(1, 2),
labels = c("Day 1", "Day 30")
),
drug_f = factor(
drug,
levels = c(1, 2),
labels = c("Heroin", "Sucrose")
)
)
lev_m5_final <- lmer(
lever ~ session_f * drug_f +
drug_f * time +
(1 | subject),
data = inc_sneek,
REML = TRUE
)
summary(lev_m5_final)
anova(lev_m5_final)
lev_m5_ml <- lmer(
lever ~ session_f * drug_f +
drug_f * time +
(1 | subject),
data = inc_sneek,
REML = FALSE
)
lev_m7_ml <- lmer(
lever ~ session_f * drug_f * time +
(1 | subject),
data = inc_sneek,
REML = FALSE
)
anova(lev_m5_ml, lev_m7_ml)
