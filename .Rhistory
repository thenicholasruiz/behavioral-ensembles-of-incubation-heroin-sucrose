alpha = 0.12
) +
# Group means
stat_summary(
aes(
group = behavior,
linetype = behavior
),
fun = mean,
geom = "line",
linewidth = 1.2
) +
# Mean +/- SE
stat_summary(
aes(
group = behavior,
linetype = behavior
),
fun.data = mean_se,
geom = "errorbar",
width = 0.15
) +
facet_wrap(~reward, scales = "free_y") +
scale_x_continuous(breaks = 1:10) +
labs(
x = "Self-administration day",
y = "Lever presses",
linetype = NULL
) +
theme_classic(base_size = 14)
